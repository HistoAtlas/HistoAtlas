---
import { readFileSync } from 'node:fs';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { AtlasPageIsland } from '../../../islands/AtlasPageIsland';
import { COHORT_FULL_NAMES } from '../../../data/cohortNames';
import { TCGA_TO_SLUG } from '../../../data/cancerSlugs';
import { getMutationPagesForCancer } from '../../../data/mutationPages';
import { GENE_BY_SLUG } from '../../../data/geneGlossary';
import { TIER1_SEO_CONTENT } from '../../../data/seoContent';
import { ALL_FEATURES } from '../../../data/featureGlossary';

export function getStaticPaths() {
  const manifest = JSON.parse(readFileSync('public/api/_manifests/datasets.json', 'utf-8'));
  const paths = [];
  for (const [dataset, info] of Object.entries(manifest)) {
    for (const cohort of (info as any).cancerTypes) {
      paths.push({ params: { dataset, cohort } });
    }
  }
  return paths;
}

const { dataset, cohort } = Astro.params;
const displayCohort = cohort ?? 'PANCAN';
const cohortFullName = COHORT_FULL_NAMES[displayCohort] ?? displayCohort;
const isPancan = displayCohort === 'PANCAN';
const datasetDisplayName = dataset?.toUpperCase() ?? 'TCGA';

const cancerSlug = TCGA_TO_SLUG[displayCohort];
const mutationPages = cancerSlug ? getMutationPagesForCancer(cancerSlug) : [];

const keyFeatures = Object.keys(TIER1_SEO_CONTENT).filter((name) => ALL_FEATURES.some((f) => f.name === name));

const cohorts: { id: string; slideCount: number }[] = JSON.parse(
  readFileSync(`public/api/${dataset}/cohorts.json`, 'utf-8'),
);
const slideCount = cohorts.find((c) => c.id === displayCohort)?.slideCount;
---

<BaseLayout
  title={`${cohortFullName} Histopathology Atlas - ${datasetDisplayName} · HistoAtlas`}
  description={`Interactive UMAP embedding visualization for the ${datasetDisplayName} ${cohortFullName} (${displayCohort}) cohort.`}
  canonicalUrl={`/${dataset}/${displayCohort}/atlas/`}
  breadcrumbs={[
    { name: datasetDisplayName, url: `/${dataset}/PANCAN/atlas/` },
    { name: cohortFullName, url: `/${dataset}/${displayCohort}/atlas/` },
  ]}
>
  <div class="bg-zinc-50">
    <!-- Server-rendered cohort header; the empty slots are filled by the React island -->
    <section aria-label="Cohort" class="relative z-[22] bg-white border-b border-zinc-200">
      <div class="max-w-7xl mx-auto px-4 md:px-6 py-3.5 flex flex-col gap-2">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <div class="flex items-center gap-1">
          <h1 class="flex items-center gap-2 text-xl font-semibold text-zinc-900">
            <a href={`/${dataset}/PANCAN/atlas/`} class="text-zinc-600 hover:text-zinc-900">{datasetDisplayName}</a>
            <span aria-hidden="true" class="font-normal text-zinc-500">/</span>
            {cohortFullName}
          </h1>
          <div id="cohort-selector-slot" class="w-8 h-8"></div>
        </div>
        <p class="w-full md:w-auto md:flex-1 text-[13px] md:text-[13.5px] text-zinc-600 md:whitespace-nowrap">
          Explore how {slideCount ? `${slideCount.toLocaleString('en-US')} ` : ''}{isPancan ? 'tumors' : 'slides'} cluster by tissue architecture.
        </p>
        <div id="atlas-actions-slot" class="hidden md:flex items-center gap-2 min-h-8"></div>
      </div>
      <div id="atlas-stats-slot" class="min-h-7"></div>
      {mutationPages.length > 0 && (
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <span class="text-[11px] font-semibold tracking-wider uppercase text-zinc-500">Common mutations</span>
          {mutationPages.slice(0, 8).map((p) => (
            <a href={`/mutations/${p.geneSlug}/${p.cancerSlug}/`}
               class="text-[12.5px] text-blue-700 hover:underline">
              {GENE_BY_SLUG[p.geneSlug]?.symbol ?? p.geneSlug.toUpperCase()} ({(p.frequency * 100).toFixed(0)}%)
            </a>
          ))}
        </div>
      )}
      </div>
    </section>
    <div id="atlas-about-slot"></div>

    <AtlasPageIsland dataset={dataset} cohort={displayCohort} keyFeatures={keyFeatures} client:only="react" />
  </div>
</BaseLayout>

<script is:inline define:vars={{ dataset, cohort: displayCohort }}>
  window.posthog?.capture('cohort_atlas_viewed', { dataset, cohort });
</script>
